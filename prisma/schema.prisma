// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Worker {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  workLogs  WorkLog[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Job {
  id              Int              @id @default(autoincrement())
  title           String           @unique
  reward          Float            // Predefined reward in CZK
  workLogs        WorkLog[]
  recommendations Recommendation[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model WorkLog {
  id         Int      @id @default(autoincrement())
  workerId   Int
  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  jobId      Int
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  date       DateTime
  isBilled   Boolean  @default(false)
  invoiceId  String?  // Keeps Fakturoid invoice number
  invoice    Invoice? @relation(fields: [invoiceId], references: [invoiceNumber], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Invoice {
  id            Int       @id @default(autoincrement())
  invoiceNumber String    @unique
  amount        Float
  status        String    @default("Unpaid") // "Unpaid", "Paid"
  issuedAt      DateTime  @default(now())
  fakturoidUrl  String?
  workLogs      WorkLog[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Recommendation {
  id              Int      @id @default(1)
  title           String   // e.g., "Front lobby cleaning"
  conditionType   String   // "ALWAYS", "DAYS_SINCE_LAST_JOB", "UNBILLED_REWARD_BELOW", "NEVER"
  conditionValue  Float    @default(0)
  jobId           Int?
  job             Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  updatedAt       DateTime @updatedAt
}
